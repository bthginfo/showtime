# Only nonowner runtime roles belong in an application environment.
APP_DATABASE_URL=postgresql://showtime_app:replace@your-development-host/showtime?sslmode=require
AUTH_DATABASE_URL=postgresql://showtime_auth:replace@your-development-host/showtime?sslmode=require
WORKER_DATABASE_URL=postgresql://showtime_worker:replace@your-development-host/showtime?sslmode=require
CONTROL_DATABASE_URL=postgresql://showtime_control:replace@your-development-host/showtime?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
APP_URL=http://127.0.0.1:3100
BETTER_AUTH_URL=http://127.0.0.1:3100
CRON_SECRET=replace-with-a-unique-random-secret
BLOB_READ_WRITE_TOKEN=replace-with-your-private-development-store-token
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-showtime-domain.example
# Optional Redis adapter; the initial installation uses durable PostgreSQL buffers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
