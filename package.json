{
  "name": "showtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3100",
    "build": "vite build && node scripts/configure-queue.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-showtime.ts",
    "bootstrap": "tsx --tsconfig tsconfig.scripts.json scripts/bootstrap-showtime.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3100",
    "test:security": "vitest run tests/tenancy tests/events",
    "postinstall": "node scripts/patch-adapter.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@lucide/svelte": "^1.55.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sveltejs/kit": "2.70.3",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "@upstash/realtime": "^1.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "latest",
    "@vercel/queue": "latest",
    "better-auth": "^1.7.6",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "fflate": "^0.8.3",
    "luxon": "^3.7.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "web-push": "^3.6.7",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "latest",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "latest",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
